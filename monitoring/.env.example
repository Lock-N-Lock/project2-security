# monitoring/.env.example


# Setup
# cd ~/project2-security
# cp monitoring/.env.example monitoring/.env
# vi monitoring/.env


# Notes

# - monitoring/.env 는 Git에 커밋하지 않습니다.
# - 이 파일(.env.example)은 예시 템플릿 용도로만 사용합니다.
# - 실제 인증 정보(API Key, Bot Token, AWS Key)는 monitoring/.env 에만 저장합니다.
# - 값 변경 후 monitoring stack 재시작이 필요할 수 있습니다.


# -------------------------------------------------------------------------

# Tailscale
# tailscale-sd가 App / DB 노드를 조회하는 데 사용합니다.
# Access Token은 기본적으로 만료 기간(90일)이 있으며,
# 만료 또는 권한 변경 시 tailscale-sd 대상 조회가 실패할 수 있습니다.

# -------------------------------------------------------------------------

# Tailscale API Access Token
TS_API_KEY=tskey-api-xxxx

# Tailnet Name
# "-" 사용 시 토큰 소유자의 기본 Tailnet 사용
TS_TAILNET=-

# -------------------------------------------------------------------------

# Telegram
# Alert 및 Recovery Notification 발송에 사용합니다.

# -------------------------------------------------------------------------

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID
TELEGRAM_CHAT_ID=

# CloudWatch Alarm Notification
# CloudWatch Alarm이 발행되는 SNS Topic 이름

SNS_TOPIC_NAME=lb-alerts

# 아래 값은 프로젝트 기본값을 사용합니다.
# LAMBDA_FUNCTION_NAME=lb-cloudwatch-telegram-notifier
# LAMBDA_ROLE_NAME=lb-cloudwatch-telegram-lambda-role

# -------------------------------------------------------------------------

# AWS CloudWatch
# Grafana CloudWatch Dashboard 및 AWS 모니터링에 사용합니다.

# -------------------------------------------------------------------------

# AWS Access Key ID
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=

# AWS Region
AWS_DEFAULT_REGION=ap-northeast-2

# CloudWatch 리소스 이름
# bootstrap_monitoring.sh가 아래 이름을 사용하여
# CloudWatch Dimension 값을 자동 생성합니다.
# APP_HEALTH_URL
# AWS_ALB_LOAD_BALANCER
# AWS_BLUE_TARGET_GROUP
# AWS_GREEN_TARGET_GROUP
# AWS_BLUE_ASG_NAME
# AWS_GREEN_ASG_NAME

# ASG Scale Notification
# ASG 인스턴스 수가 기준값 이상으로 증가하면
# CloudWatch Alarm → SNS → Lambda → Telegram으로 알림을 전송합니다.
# ALARM: Scale Out 감지
# OK: 기본 인스턴스 수로 복귀

AWS_BLUE_ASG_NAME=lb-asg-blue
ASG_SCALE_ALARM_ENABLED=true
ASG_SCALE_ALARM_THRESHOLD=2
ASG_SCALE_ALARM_PERIOD=300
ASG_SCALE_ALARM_EVALUATION_PERIODS=1

# -------------------------------------------------------------------------

# Recovery
# Recovery Controller가 Bastion을 경유하여 AWS App 서버의
# 컨테이너를 재시작하고 /health 검증을 수행하는 데 사용합니다.
# 실제 값은 bootstrap을 통해 monitoring/.env에 입력합니다.

# -------------------------------------------------------------------------

# AWS_APP_PRIVATE_IP=${AWS_APP_PRIVATE_IP}
# AWS_BASTION_PUBLIC_IP=${AWS_BASTION_PUBLIC_IP}
# APP_CONTAINER_NAME=lockbank-app
# AWS_SSH_KEY_PATH=/app/ssh/lb-key.pem