                            </iframe>
                        </div>
                    </div>
                </section>
        </main>
    </div>

<script>
    function showSection(sectionId, button) {
        document.querySelectorAll('.section').forEach(section => {
            section.classList.remove('active');
        });

        document.getElementById(sectionId).classList.add('active');

        document.querySelectorAll('.menu button').forEach(item => {
            item.classList.remove('active');
        });

        button.classList.add('active');

        localStorage.setItem('activeSection', sectionId);
    }

    window.addEventListener('DOMContentLoaded', () => {
        const saved = localStorage.getItem('activeSection') || 'overview';
        const button = document.querySelector(`button[onclick*="'${saved}'"]`);
        if (button) showSection(saved, button);

        // Refresh interval is handled by Grafana dashboard settings.

    });
</script>
</body>

</html>