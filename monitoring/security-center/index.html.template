<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>LockBank Security Center</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #ffffff;
        color: #111827;
    }

    .layout {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
        width: 260px;
        background: #ffffff;
        border-right: 1px solid #dbe3ef;
        padding: 28px 20px;
        box-shadow: none;
        position: sticky;
        top: 0;
        height: 100vh;
        box-sizing: border-box;
        margin: 1px;
        display: flex;
        flex-direction: column;
    }

    .brand {
        font-size: 22px;
        font-weight: 800;
        color: #1d4ed8;
        margin-bottom: 8px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .brand-subtitle {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 34px;
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .menu button {
        width: calc(100% + 40px);
        margin-left: -20px;
        margin-right: -20px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #374151;
        text-align: left;
        padding: 15px 24px;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: -0.2px;
        cursor: pointer;
        display: flex;
        gap: 12px;
        align-items: center;
        transition: background 0.12s ease, color 0.12s ease;
        transform: none;
    }

    .menu button:hover {
        background: #f3f6ff;
        color: #374151;
    }

    .menu button.active {
        background: #eaf1ff;
        color: #1d4ed8;
    }

    /* Content */
    .content {
        flex: 1;
        padding: 28px 36px;
        box-sizing: border-box;
    }

    .topbar {
        display: none;
    }

    .section {
        display: none;
    }

    .section.active {
        display: block;
    }

    .section-title {
        font-size: 20px;
        font-weight: 800;
        margin: 0 0 6px;
        color: #111827;
    }

    .section-desc {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 18px;
        line-height: 1.5;
    }

    /* Common card */
    .card {
        background: #ffffff;
        border: 1px solid #e5eaf2;
        border-radius: 14px;
        padding: 14px;
        box-shadow: none;
    }

    .card-title {
        font-size: 13px;
        color: #334155;
        font-weight: 800;
        margin-bottom: 10px;
    }

    iframe {
        width: 100%;
        height: 280px;
        border: 0;
        border-radius: 8px;
        background: #ffffff;
    }

    /* Basic grids */
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        gap: 20px;
    }

    .card-grid.overview-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .stat-grid .card.stat {
        padding: 12px;
    }

    .stat-grid .card.stat iframe {
        height: 180px;
    }

    .stat-grid.compact {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 20px;
    }

    .card.stat iframe {
        height: 120px;
    }

    .chart-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 10px;
    }

    .card.chart iframe {
        height: 240px;
    }

    .log-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .log-grid .wide iframe {
        height: 360px;
    }

    .compact-log .wide iframe {
        height: 180px;
    }

    .wide {
        grid-column: 1 / -1;
    }

    .wide iframe {
        height: 430px;
    }

    /* Recovery section */
    .recovery-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .recovery-grid .card.stat iframe {
        height: 180px;
    }

    .recovery-main-log {
        margin-bottom: 20px;
    }

    .recovery-main-log iframe {
        height: 200px;
    }

    .recovery-critical-log {
        margin-top: 20px;
    }

    .recovery-critical-log iframe {
        height: 100px;
    }

    /* Sidebar bottom info */
    .side-info {
        margin-top: auto;
        padding: 0;
    }

    .side-info-title {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 10px;
        font-weight: 800;
        color: #111827;
        margin: 10px 0 8px;
        text-transform: uppercase;
    }

    .side-info-title:first-child {
        margin-top: 0;
    }

    .side-info-row {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 10px;
        font-weight: 500;
        color: #111827;
        margin-bottom: 5px;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #1d4ed8;
        display: inline-block;
    }

    .side-tag {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #1d4ed8;
        background: #eaf1ff;
        padding: 6px 9px;
        border-radius: 999px;
        margin: 6px 0;
        text-align: center;
}

        @media (max-width: 900px) {
            .layout {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: auto;
                position: static;
                border-right: 0;
                border-bottom: 1px solid #e5e7eb;
            }

            .menu {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
            }

            .content {
                padding: 20px;
            }
        }

        @media (max-width: 560px) {
            .menu {
                grid-template-columns: 1fr;
            }

            .card-grid {
                grid-template-columns: 1fr;
            }

            iframe {
                height: 250px;
            }
        }
    </style>
</head>

<body>
